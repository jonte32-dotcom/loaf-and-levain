# Loaf & Levain — environment variables (copy to .env / set in CI or Cloudflare Pages).
# Never commit real secret values. config.local.json and .env are gitignored.

# --- Secrets (set as GitHub Actions secrets and/or Cloudflare Pages env, NOT in files) ---
ANTHROPIC_API_KEY=sk-ant-...        # used by scripts/gen-article.js (weekly content cron)
MAILERLITE_TOKEN=eyJ...             # used by the welcome-drip mail pipeline

# --- Build-time config (safe to set in Cloudflare Pages project settings) ---
# Author identity drives the byline, the Person JSON-LD, the author bio box and the About page.
# This is the single highest-impact AdSense "E-E-A-T" signal — set it to a REAL full name.
AUTHOR_NAME=                        # e.g. "Jane Andersson" (empty falls back to the code default)
AUTHOR_BIO=                         # one-line credential, e.g. "a home baker who tests every number in a real kitchen"

ANTHROPIC_MODEL=claude-opus-4-7     # override the article-generation model without a code change
SITE_BASE=https://loafandlevain.com # canonical origin used in URLs, sitemap and JSON-LD
CONTACT_EMAIL=loafandlevain.bake@gmail.com  # shown on the Contact page
